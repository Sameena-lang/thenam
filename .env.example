# Admin Authentication & Initial Provisioning
# The initial administrator account will be provisioned on first startup if no admin exists.
ADMIN_INITIAL_EMAIL=admin@thenamsoft.com
ADMIN_INITIAL_PASSWORD=ThenamAdmin#2026
ADMIN_INITIAL_NAME="Thenam Administrator"

# Secret key used for signing session tokens and hashing (minimum 32 characters)
ADMIN_SESSION_SECRET=thenam_super_secure_random_session_secret_key_2026

# Database Path (optional, defaults to ./data/thenam.db)
DATABASE_PATH=./data/thenam.db
