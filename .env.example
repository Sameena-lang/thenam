# ========================================================
# THENAM Software Solutions - Environment Configuration
# ========================================================

# 1. Administrator Initial Provisioning (Safe defaults for first start)
ADMIN_INITIAL_EMAIL=admin@thenamsoft.com
ADMIN_INITIAL_PASSWORD=ThenamAdmin#2026
ADMIN_INITIAL_NAME="Thenam Administrator"

# 2. Session Cryptographic Secret (Replace in production with 32+ char random string)
ADMIN_SESSION_SECRET=thenam_secure_production_secret_key_change_me_2026

# 3. Local SQLite Database (Active for local development)
DATABASE_PATH=./data/thenam.db

# 4. Managed PostgreSQL (Required for Serverless Deployments such as Vercel)
# When deploying to Vercel or cloud serverless environments where local file storage is ephemeral,
# provide a connection string from Supabase, Neon, or AWS RDS:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require

